# Embeds SPIR-V files in one C++ header, each as a uint32_t array and a span
# over it (what jvk::compute::Context::kernel() takes). Run by
# jvk_compute_shaders() as a build step:
#   cmake -DOUTPUT=<header> -DNAMESPACE=<ns> -DNAMES=<a|b> -DFILES=<a.spv|b.spv> -P jvk_embed_spirv.cmake
# The header is rewritten only when its text changes, so a shader edit that
# compiles to the same SPIR-V rebuilds nothing.

string(REPLACE "|" ";" NAMES "${NAMES}")
string(REPLACE "|" ";" FILES "${FILES}")

set(_text "// Generated by jvk_compute_shaders() from GLSL compute shaders: do not edit.\n")
string(APPEND _text "#pragma once\n#include <cstdint>\n#include <span>\n\nnamespace ${NAMESPACE}\n{\n")
foreach(_name _file IN ZIP_LISTS NAMES FILES)
    file(READ "${_file}" _hex HEX)
    string(LENGTH "${_hex}" _length)
    math(EXPR _remainder "${_length} % 8")
    if(NOT _remainder EQUAL 0 OR _length EQUAL 0)
        message(FATAL_ERROR "jvk: ${_file} is not SPIR-V (not whole 32-bit words)")
    endif()
    # SPIR-V words are little-endian in the file: each word's four bytes, reversed, as one hex number.
    string(REGEX REPLACE "([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])" "0x\\4\\3\\2\\1u," _words "${_hex}")
    # Eight words a line (CMake's regular expressions have no {8}).
    set(_word "0x[0-9a-f]+u,")
    string(REGEX REPLACE "(${_word}${_word}${_word}${_word}${_word}${_word}${_word}${_word})" "\\1\n    " _words "${_words}")
    string(APPEND _text "inline constexpr uint32_t ${_name}_words[] = {\n    ${_words}\n};\n")
    string(APPEND _text "inline constexpr std::span<const uint32_t> ${_name} { ${_name}_words };\n\n")
endforeach()
string(APPEND _text "} // namespace ${NAMESPACE}\n")

if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" _old)
    if(_old STREQUAL _text)
        return()
    endif()
endif()
file(WRITE "${OUTPUT}" "${_text}")
